    "Invoice": {
      "title": "Invoice",
      "description": "Player tuition and billing invoice",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "invoiceNumber": { "type": "string" },
        "playerId": { "type": "string" },
        "playerName": { "type": "string" },
        "playerBranch": { "type": "string" },
