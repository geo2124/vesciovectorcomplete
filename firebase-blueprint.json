      "description": "Role-scoped persistent academy alerts"
    },
    "/tenants/{tenantId}/cron_logs/{logId}": {
      "schema": "CronLog",
      "description": "Server-authoritative billing cron and suspension audit execution logs"
    },
    "/tenants/{tenantId}/users/{uid}": {
      "schema": "UserRole",
      "description": "Tenant users and roles"
    },
    "/tenants/{tenantId}/customRoles/{roleId}": {
      "schema": "RoleDefinition",
      "description": "Tenant custom and system roles with granular permissions"
    },
    "/tenants/{tenantId}/groups/{groupId}": {
      "schema": "WhatsAppGroup",
      "description": "WhatsApp communication groups"
    },
    "/tenants/{tenantId}/resourceFolders/{folderId}": {
      "schema": "ResourceFolder",
      "description": "Technical director coaching resource folders"
    },
    "/tenants/{tenantId}/workshops/{workshopId}": {
      "schema": "Workshop",
      "description": "Staff development and coaching workshops"
    },
    "/tenants/{tenantId}/errorLogs/{logId}": {
      "schema": "CronLog",
      "description": "Telemetry and diagnostic error logs"
    },
    "/tenants/{tenantId}/crmLeads/{leadId}": {
      "schema": "CrmLead",
      "description": "Basketball academy CRM pipeline leads and client lifecycle records"
    },
    "/users/{uid}": {
      "schema": "UserRole",
      "description": "Root user role document for Super Admin and RBAC checks"
    },
    "/platformClients/{clientId}": {
      "schema": "PlatformClient",
      "description": "Platform clients for super-admin"
    }
  }
